    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "paste_plus",
            "request": "launch",
            "type": "dart",
            "env": {
                "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
            }
        },
        {
            "name": "paste_plus (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "env": {
                "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
            }
        },
        {
            "name": "paste_plus (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "env": {
                "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
            }
        }
    ]
}